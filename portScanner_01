#start
import socket
print('port scanner scanning...')

#validate IP
target = input('Enter target IP address: ')
try:
    socket.inet_aton(target)
except socket.error:
    print('Invalid IP Address')
    exit()

#port scan funct
def scan_port(ip, port):
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(1)
        result = sock.connect_ex((ip, port))
        sock.close()
        if result == 0:
            return True
        else:
            return False
    except socket.error:
        return False

#port use
services = {
    21: "FTP",
    22: "SSH",
    23: "Telnet",
    25: "SMTP",
    53: "DNS",
    80: "HTTP",
    110: "POP3",
    111: "RPCbind",
    139: "NetBIOS",
    443: "HTTPS",
    445: "SMB",
    512: "rexec",
    513: "rlogin",
    514: "rsh",
    3306: "MySQL",
    3389: "RDP",
    8080: "HTTP-Alt"
}    
    
print(f"Scanning {target}...")

#running loop & putting results in txt.file
with open("scan_results.txt", "w") as f:
    f.write(f"Scan results for {target}\n")
    f.write("=" * 30 + "\n")
    for port in range(1, 1001):
        if scan_port(target, port):
            service = services.get(port, "Unknown")
            print(f"Port {port} is open -- {service}")
            f.write(f"Port {port} is open -- {service}\n")        
